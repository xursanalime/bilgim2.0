// Bilgim — Prisma schema (docs/bilgim2.0.md §6).
//
// Qoidalar:
//  - UUID primary keylar; timestamps UTC timestamptz;
//  - global rol yo'q — rol SchoolMember jadvalida (§1.2);
//  - har tenant jadvali school_id bilan scope qilinadi — istisno yo'q.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DELETED
}

/// Maktab holati (§2.1). ACTIVE boshqa statuslarga o'tishi mumkin; slug har doim reserve.
enum SchoolStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  CLOSED
}

/// Rol maktabga tegishli (SchoolMember), global User.rolega emas (§1.2).
enum SchoolMemberRole {
  OWNER
  TEACHER
  ASSISTANT
  MODERATOR
  STUDENT
}

enum SchoolMemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum SchoolDomainKind {
  PLATFORM_SUBDOMAIN
  CUSTOM
}

/// Public landing template'lari (§4.1.1). Faqat layout almashtiradi; data modeli bir xil.
enum LandingTemplate {
  CLASSIC
  MINIMAL
  BOLD
}

enum ConsentStatus {
  NONE
  PENDING
  GRANTED
  REVOKED
}

// ── Catalog / cohort / learning (Faza 2, §6.3) ─────────────────────────────

enum CourseVisibility {
  DRAFT
  PUBLIC
  UNLISTED
  ARCHIVED
}

enum LessonType {
  VIDEO
  LIVE
  HYBRID
  TEXT
  QUIZ
}

enum LessonStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CohortStatus {
  DRAFT
  ACTIVE
  FULL
  CANCELLED
  ENDED
}

enum PriceBillingModel {
  FREE
  ONE_TIME
  INSTALLMENT
  RECURRING_MEMBERSHIP
}

enum EnrollmentStatus {
  PENDING_PAYMENT
  PENDING_APPROVAL
  ACTIVE
  COMPLETED
  REVOKED
  REFUNDED
}

enum EnrollmentAccessSource {
  ORDER
  MEMBERSHIP
  MANUAL
  INVITE
}

enum LockedReason {
  NOT_STARTED
  DRIP
  PREVIOUS_INCOMPLETE
  MEMBERSHIP_PAST_DUE
  ENROLLMENT_REVOKED
  PLAN_LIMIT
}

// ── Subscription / Entitlement (Faza 3, §4.4, §4.5) ────────────────────────

enum PlanCode {
  FREE
  PRO
  MAX
}

enum SubscriptionState {
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum UsageMeterKey {
  LIVE_PARTICIPANT_MINUTE
  LIVE_RECORDED_MINUTE
  MEDIA_STORAGE_GB_MONTH
  AI_REQUEST
}

enum QuotaUnit {
  COUNT
  STORAGE_BYTES
  DURATION_MINUTES
}

/// Global user — authentication subyekti. Rol shu yerda YO'Q (§1.2):
/// authorization SchoolMember orqali maktab bo'yicha bajariladi.
model User {
  id                String     @id @default(uuid()) @db.Uuid
  email             String     @unique @db.Citext
  phone             String?
  passwordHash      String     @map("password_hash")
  fullName          String     @map("full_name")
  /// Media asset FK media modulida qo'shiladi (Faza 2)
  avatarAssetId     String?    @map("avatar_asset_id") @db.Uuid
  locale            String     @default("uz")
  status            UserStatus @default(PENDING_VERIFICATION)
  /// Password reset / suspension paytida barcha sessiyalarni bekor qilish belgisi
  sessionsRevokedAt DateTime?  @map("sessions_revoked_at") @db.Timestamptz()
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz()

  sessions Session[]

  // Faza 1 — tenant/identity munosabatlari
  schoolMembers SchoolMember[]
  ownedSchools  School[]       @relation("SchoolOwner")
  testimonials  LandingTestimonial[]

  @@map("users")
}

/// Schools — har bir maktab slug.bilgim.uz subdomenida (§2, §6.2).
model School {
  id            String       @id @default(uuid()) @db.Uuid
  slug          String       @unique @db.Citext
  name          String
  status        SchoolStatus @default(DRAFT)
  ownerUserId   String       @map("owner_user_id") @db.Uuid
  timezone      String       @default("Asia/Tashkent")
  defaultLocale String       @default("uz") @map("default_locale")
  /// Brand tokenlari, logo/cover va owner public profili — JsonB (query qilinmaydi)
  brandJson     Json?        @map("brand_json") @db.JsonB
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz()

  owner User        @relation("SchoolOwner", fields: [ownerUserId], references: [id])
  members SchoolMember[]
  holidays SchoolHoliday[]
  invites  SchoolInvitation[]
  domains  SchoolDomain[]
  landing  SchoolLandingPage?
  highlights LandingHighlight[]
  successStories LandingSuccessStory[]
  testimonials LandingTestimonial[]
  courses Course[]
  lessons Lesson[]
  enrollments Enrollment[]
  pricingOffers PricingOffer[]
  subscriptions SchoolSubscription[]
  usageWallet   UsageWallet?

  @@index([ownerUserId])
  @@map("schools")
}

/// Maktabning mahalliy kalendar ta'til kunlari — streak calculator va calendar source-of-truth (§4.3.1).
model SchoolHoliday {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  startAt   DateTime @map("start_at") @db.Timestamptz()
  endAt     DateTime @map("end_at") @db.Timestamptz()
  title     String
  isPublished Boolean @default(true) @map("is_published")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@map("school_holidays")
}

/// Tenant authorization — rol va status maktabga scope (§5.3).
model SchoolMember {
  id        String    @id @default(uuid()) @db.Uuid
  schoolId  String    @map("school_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  role      SchoolMemberRole
  status    SchoolMemberStatus @default(INVITED)
  invitedBy String?   @map("invited_by") @db.Uuid
  joinedAt  DateTime? @map("joined_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([schoolId, userId])
  @@index([userId, status])
  @@map("school_members")
}

/// Root `/my-schools` minimal sumkasi uchun account-level read model (§2.2).
model MemberSchoolSummary {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  schoolId      String    @map("school_id") @db.Uuid
  nextLessonAt  DateTime? @map("next_lesson_at") @db.Timestamptz()
  unreadMessageCount Int  @default(0) @map("unread_message_count")
  membershipVersion Int  @default(1) @map("membership_version")
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  @@unique([userId, schoolId])
  @@index([userId])
  @@map("member_school_summaries")
}

/// Maktabga taklif — hashed token; yakuniy target e-mail (P1'da implementatsiya).
model SchoolInvitation {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @map("school_id") @db.Uuid
  tokenHash   String   @unique @map("token_hash")
  targetEmail String   @map("target_email")
  role        SchoolMemberRole
  expiresAt   DateTime @map("expires_at") @db.Timestamptz()
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz()
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz()
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@map("school_invitations")
}

/// Reserved hostname'lar — P1'da faqat platforma subdomen satri yaratiladi.
model SchoolDomain {
  id            String           @id @default(uuid()) @db.Uuid
  schoolId      String           @map("school_id") @db.Uuid
  hostname      String           @unique @db.Citext
  kind          SchoolDomainKind
  verifiedAt    DateTime?        @map("verified_at") @db.Timestamptz()
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("school_domains")
}

/// Public landing — one-to-one; unsafe HTML field yo'q (§4.1.1).
model SchoolLandingPage {
  id                 String          @id @default(uuid()) @db.Uuid
  schoolId           String          @unique @map("school_id") @db.Uuid
  template           LandingTemplate @default(CLASSIC)
  heroJson           Json?           @map("hero") @db.JsonB
  faqJson            Json?           @map("faq") @db.JsonB
  contactJson        Json?           @map("contact") @db.JsonB
  seoJson            Json?           @map("seo") @db.JsonB
  isPublished        Boolean         @default(false) @map("is_published")
  publishedVersion   Int?            @map("published_version")
  publishedAt        DateTime?       @map("published_at") @db.Timestamptz()
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz()

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("school_landing_pages")
}

/// Owner-defined trust metric (audit bilan) — §4.1.1 Trust metrics bloki.
model LandingHighlight {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @map("school_id") @db.Uuid
  label       String
  value       String
  iconKey     String?  @map("icon_key")
  position    Int      @default(0)
  isPublished Boolean  @default(false) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@map("landing_highlights")
}

/// Student natija hikoyasi — PUBLIC_CONSENT bo'lmasa query'dan ham chiqmaydi (§4.1.1).
model LandingSuccessStory {
  id             String        @id @default(uuid()) @db.Uuid
  schoolId       String        @map("school_id") @db.Uuid
  title          String
  body           String
  metricLabel    String?       @map("metric_label")
  metricValue    String?       @map("metric_value")
  studentAlias   String        @map("student_alias")
  consentStatus  ConsentStatus @default(PENDING) @map("consent_status")
  consentedAt    DateTime?     @map("consented_at") @db.Timestamptz()
  isPublished    Boolean       @default(false) @map("is_published")
  position       Int           @default(0)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz()

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@map("landing_success_stories")
}

/// Testimonial — author consenti talab; owner o'zi yozgan fikrni testimonial deb publish qila olmaydi (§4.1.1).
model LandingTestimonial {
  id            String        @id @default(uuid()) @db.Uuid
  schoolId      String        @map("school_id") @db.Uuid
  authorUserId  String?       @map("author_user_id") @db.Uuid
  displayName   String        @map("display_name")
  body          String
  courseLabel   String?       @map("course_label")
  consentStatus ConsentStatus @default(PENDING) @map("consent_status")
  consentedAt   DateTime?     @map("consented_at") @db.Timestamptz()
  isPublished   Boolean       @default(false) @map("is_published")
  position      Int           @default(0)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz()

  school School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  author User?   @relation(fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([schoolId, isPublished])
  @@map("landing_testimonials")
}

/// Audit log — plan/identity mutatsiyalari uchun immutable hash zanjiri (§9).
model AuditEvent {
  id           String   @id @default(uuid()) @db.Uuid
  schoolId     String?  @map("school_id") @db.Uuid
  actorUserId  String   @map("actor_user_id") @db.Uuid
  action       String
  entityType   String   @map("entity_type")
  entityId     String?  @map("entity_id")
  requestId    String?  @map("request_id")
  ipAddress    String?  @map("ip_address")
  prevJson     Json?    @map("prev") @db.JsonB
  nextJson     Json?    @map("next") @db.JsonB
  hash         String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([schoolId, createdAt])
  @@index([actorUserId])
  @@map("audit_events")
}

// ── Catalog / Cohort (Faza 2) ──────────────────────────────────────────────

/// Course — marketing/content konteyneri; narx cohort'a tegishli (§4.3).
model Course {
  id           String           @id @default(uuid()) @db.Uuid
  schoolId     String           @map("school_id") @db.Uuid
  slug         String
  title        String
  description  String?
  level        String?
  coverAssetId String?          @map("cover_asset_id") @db.Uuid
  visibility   CourseVisibility @default(DRAFT)
  /// Immutable published revision soni — published kontent o'chirilmaydi (§4.3)
  version      Int              @default(1)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz()

  school  School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sections CourseSection[]
  cohorts  Cohort[]
  lessons  Lesson[]
  enrollments Enrollment[]

  @@unique([schoolId, slug])
  @@index([schoolId, visibility])
  @@map("courses")
}

/// Course ichidagi section — position bo'yicha immutable published revision.
model CourseSection {
  id        String   @id @default(uuid()) @db.Uuid
  courseId  String   @map("course_id") @db.Uuid
  title     String
  position  Int
  isPublished Boolean @default(false) @map("is_published")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@unique([courseId, position])
  @@index([courseId])
  @@map("course_sections")
}

/// Lesson — VIDEO|LIVE|HYBRID|TEXT|QUIZ (§4.3).
model Lesson {
  id              String       @id @default(uuid()) @db.Uuid
  schoolId        String       @map("school_id") @db.Uuid
  courseId        String       @map("course_id") @db.Uuid
  sectionId       String?      @map("section_id") @db.Uuid
  slug            String
  type            LessonType
  title           String
  status          LessonStatus @default(DRAFT)
  position        Int
  contentJson     Json?        @map("content_json") @db.JsonB
  estimatedMinutes Int?        @map("estimated_minutes")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz()

  course  Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  section CourseSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  school  School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([courseId, slug])
  @@index([schoolId])
  @@map("lessons")
}

/// Cohort — vaqt, narx, capacity va haqiqiy guruh (§4.3).
model Cohort {
  id          String       @id @default(uuid()) @db.Uuid
  schoolId    String       @map("school_id") @db.Uuid
  courseId    String       @map("course_id") @db.Uuid
  title       String
  capacity    Int?
  startsAt    DateTime?    @map("starts_at") @db.Timestamptz()
  endsAt      DateTime?    @map("ends_at") @db.Timestamptz()
  status      CohortStatus @default(DRAFT)
  visibility  CourseVisibility @default(UNLISTED)
  timezone    String       @default("Asia/Tashkent")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz()

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]
  teachers     CohortTeacher[]
  offers       PricingOffer[]

  @@index([schoolId, courseId])
  @@map("cohorts")
}

/// Cohort teacher — PRIMARY|TEACHER, unique pair (§6.3).
model CohortTeacher {
  id       String @id @default(uuid()) @db.Uuid
  cohortId String @map("cohort_id") @db.Uuid
  memberId String @map("member_id") @db.Uuid
  role     String @default("TEACHER")

  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@unique([cohortId, memberId])
  @@map("cohort_teachers")
}

// ── Pricing / Enrollment / Access (Faza 2) ─────────────────────────────────

/// Versionlangan pricing offer — school-targetga bir faol versiya (§4.3, §6.3).
model PricingOffer {
  id              String           @id @default(uuid()) @db.Uuid
  schoolId        String           @map("school_id") @db.Uuid
  sellableType    String           @map("sellable_type") // COURSE | COHORT | MEMBERSHIP_PLAN
  sellableId      String?          @map("sellable_id")
  cohortId        String?          @map("cohort_id") @db.Uuid
  version         Int              @default(1)
  billingModel    PriceBillingModel @map("billing_model")
  priceUzs        Int              @map("price_uzs")
  intervalDays    Int?             @map("interval_days")
  trialDays       Int?             @map("trial_days")
  enrollmentApproval Boolean         @default(true) @map("enrollment_approval")
  availability    String           @default("OPEN") // OPEN | WAITLIST | CLOSED
  capacity        Int?
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  cohort Cohort? @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, sellableType, sellableId])
  @@map("pricing_offers")
}

/// Enrollment — student ning course/cohort accessi. Unique active per (student,cohort).
model Enrollment {
  id            String               @id @default(uuid()) @db.Uuid
  schoolId      String               @map("school_id") @db.Uuid
  studentUserId String               @map("student_user_id") @db.Uuid
  courseId      String               @map("course_id") @db.Uuid
  cohortId      String?              @map("cohort_id") @db.Uuid
  status        EnrollmentStatus     @default(PENDING_APPROVAL)
  accessSource  EnrollmentAccessSource @default(MANUAL) @map("access_source")
  offerVersion  Int?
  activatedAt   DateTime?            @map("activated_at") @db.Timestamptz()
  expiresAt     DateTime?            @map("expires_at") @db.Timestamptz()
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz()

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  cohort Cohort? @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  lessonAccess LessonAccess[]

  @@index([schoolId, studentUserId, status])
  @@map("enrollments")
}

/// Lesson access — server hisoblaydi; student uchun DRIP/lock (§4.3, §4.5).
model LessonAccess {
  id            String       @id @default(uuid()) @db.Uuid
  enrollmentId  String       @map("enrollment_id") @db.Uuid
  lessonId      String       @map("lesson_id") @db.Uuid
  schoolId      String       @map("school_id") @db.Uuid
  availableAt   DateTime?    @map("available_at") @db.Timestamptz()
  lockedReason  LockedReason? @map("locked_reason")
  completedAt   DateTime?    @map("completed_at") @db.Timestamptz()
  lastPositionSeconds Int?   @map("last_position_seconds")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz()

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
  @@index([schoolId])
  @@map("lesson_access")
}

/// Immutable progress events — dedupe source event; rollup lesson_access (§6.3).
model LessonProgressEvent {
  id           String   @id @default(uuid()) @db.Uuid
  schoolId     String   @map("school_id") @db.Uuid
  enrollmentId String   @map("enrollment_id") @db.Uuid
  lessonId     String   @map("lesson_id") @db.Uuid
  eventType    String   @map("event_type") // WATCH|OPEN|COMPLETE
  sourceKey    String?  @unique @map("source_key")
  occurredAt   DateTime @default(now()) @map("occurred_at") @db.Timestamptz()

  @@index([enrollmentId, lessonId])
  @@map("lesson_progress_events")
}

/// Refresh session — hashed refresh token, rotation/reuse detection Faza 1'da.
model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz()
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz()
  /// Device/IP metadata — audit va reuse detection uchun
  deviceLabel      String?   @map("device_label")
  ipAddress        String?   @map("ip_address")
  userAgent        String?   @map("user_agent")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("sessions")
}

// ── Subscription katalog / entitlement (Faza 3, §4.4) ─────────────────────

/// Platforma input plan (global). Yangi narx → yangi row/version (§4.4).
model PlatformPlan {
  id             String   @id @default(uuid()) @db.Uuid
  code           PlanCode
  displayName    String   @map("display_name")
  version        Int      @default(1)
  monthlyPriceUzs Int?     @map("monthly_price_uzs")
  annualPriceUzs  Int?     @map("annual_price_uzs")
  currency       String   @default("UZS")
  billingInterval String  @default("MONTHLY") @map("billing_interval")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  entitlements     PlanEntitlement[]
  usagePrices      PlanUsagePrice[]
  subscriptionSnapshots SchoolSubscription[]

  @@unique([code, version])
  @@map("platform_plans")
}

/// Closed-catalog feature key + limit (har plan barcha key bilan seeded).
model PlanEntitlement {
  id          String   @id @default(uuid()) @db.Uuid
  planId      String   @map("plan_id") @db.Uuid
  featureKey  String   @map("feature_key")
  enabled     Boolean  @default(false)
  limitValue  BigInt?  @map("limit_value")
  unit        QuotaUnit @default(COUNT)

  plan PlatformPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureKey])
  @@map("plan_entitlements")
}

/// Metered overage UXS price (Free'da enabled emas, §4.5).
model PlanUsagePrice {
  id        String       @id @default(uuid()) @db.Uuid
  planId    String       @map("plan_id") @db.Uuid
  meterKey  UsageMeterKey @map("meter_key")
  unitPriceUzs Int        @map("unit_price_uzs")
  enabled   Boolean      @default(false)

  plan PlatformPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, meterKey])
  @@map("plan_usage_prices")
}

/// Maktab subscription — snapshot + subscription_version (§4.5).
model SchoolSubscription {
  id                String           @id @default(uuid()) @db.Uuid
  schoolId          String           @map("school_id") @db.Uuid
  planId            String           @map("plan_id") @db.Uuid
  state             SubscriptionState @default(ACTIVE)
  subscriptionVersion Int            @default(1) @map("subscription_version")
  monthlyPriceUzs   Int?             @map("monthly_price_uzs")
  periodStart       DateTime?        @map("period_start") @db.Timestamptz()
  periodEnd         DateTime?        @map("period_end") @db.Timestamptz()
  canceledAt        DateTime?        @map("canceled_at") @db.Timestamptz()
  allowPaidOverage  Boolean          @default(false) @map("allow_paid_overage")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz()

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  plan   PlatformPlan @relation(fields: [planId], references: [id])
  entitlements SchoolSubscriptionEntitlement[]
  usagePrices  SchoolSubscriptionUsagePrice[]
  usageLedgers EntitlementUsage[]

  @@unique([schoolId, subscriptionVersion])
  @@map("school_subscriptions")
}

/// Subscription snapshot entitlement — exact explicit satrlar (§4.4).
model SchoolSubscriptionEntitlement {
  id            String  @id @default(uuid()) @db.Uuid
  subscriptionId String @map("subscription_id") @db.Uuid
  featureKey    String  @map("feature_key")
  enabled       Boolean @default(false)
  limitValue    BigInt?
  unit          QuotaUnit @default(COUNT)

  subscription SchoolSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, featureKey])
  @@map("school_subscription_entitlements")
}

/// Subscription snapshot usage price — yechilmob (immutable).
model SchoolSubscriptionUsagePrice {
  id            String       @id @default(uuid()) @db.Uuid
  subscriptionId String      @map("subscription_id") @db.Uuid
  meterKey      UsageMeterKey @map("meter_key")
  unitPriceUzs  Int          @map("unit_price_uzs")
  enabled       Boolean      @default(false)

  subscription SchoolSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, meterKey])
  @@map("school_subscription_usage_prices")
}

/// Quota/usage atomic counter (§4.5) — unique per subscription/period/feature.
model EntitlementUsage {
  id               String   @id @default(uuid()) @db.Uuid
  subscriptionId   String   @map("subscription_id") @db.Uuid
  periodStart      DateTime @map("period_start") @db.Timestamptz()
  featureKey       String   @map("feature_key")
  reserved         BigInt   @default(0)
  actual           BigInt   @default(0)

  subscription SchoolSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, periodStart, featureKey])
  @@map("entitlement_usage")
}

/// Prepaid usage wallet — overage uchun UZS (§4.5).
model UsageWallet {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @unique @map("school_id") @db.Uuid
  currency  String   @default("UZS")
  available Int      @default(0)
  reserved  Int      @default(0)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  entries UsageWalletEntry[]

  @@map("usage_wallets")
}

model UsageWalletEntry {
  id        String   @id @default(uuid()) @db.Uuid
  walletId  String   @map("wallet_id") @db.Uuid
  kind      String // TOP_UP | HOLD | CAPTURE | RELEASE | REFUND
  amount    Int
  reference String?
  idempotencyKey String? @unique @map("idempotency_key")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  wallet UsageWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@map("usage_wallet_entries")
}

/// Metered usage chargelar (RESERVED|CAPTURED|RELEASED).
model UsageCharge {
  id             String       @id @default(uuid()) @db.Uuid
  subscriptionId String       @map("subscription_id") @db.Uuid
  meterKey       UsageMeterKey @map("meter_key")
  quantity       Int
  unitPriceUzs   Int          @map("unit_price_uzs")
  amountUzs      Int          @map("amount_uzs")
  state          String       @default("RESERVED")
  resourceRef    String?      @map("resource_ref")
  idempotencyKey String?      @unique @map("idempotency_key")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz()

  @@index([subscriptionId])
  @@map("usage_charges")
}

// ── Orders / Payments / Coupons (Faza 3, §6.5) ─────────────────────────────

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELED
  FAILED
  REFUNDED
}

enum PaymentState {
  INITIATED
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

enum PaymentProvider {
  PAYME
  CLICK
  UZUM
}

/// Student course/cohort yoki SaaS subscription order — immutable money snapshot.
model Order {
  id            String      @id @default(uuid()) @db.Uuid
  schoolId      String      @map("school_id") @db.Uuid
  buyerUserId   String      @map("buyer_user_id") @db.Uuid
  purpose       String      // STUDENT_ENROLLMENT | STUDENT_MEMBERSHIP | INSTALLMENT_DUE | SCHOOL_SUBSCRIPTION | USAGE_WALLET_TOPUP
  status        OrderStatus @default(PENDING)
  subtotalUzs   Int         @map("subtotal_uzs")
  discountUzs   Int         @default(0) @map("discount_uzs")
  totalUzs      Int         @map("total_uzs")
  currency      String      @default("UZS")
  idempotencyKey String?    @unique @map("idempotency_key")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz()

  items    OrderItem[]
  payments Payment[]
  couponRedemptions CouponRedemption[]

  @@index([schoolId, buyerUserId])
  @@map("orders")
}

/// Course narxi klientdan qabul qilinmaydi (§6.5) — server snapshot.
model OrderItem {
  id            String  @id @default(uuid()) @db.Uuid
  orderId       String  @map("order_id") @db.Uuid
  referenceType String  @map("reference_type") // COURSE | COHORT | MEMBERSHIP_PLAN | PLAN
  referenceId   String  @map("reference_id")
  quantity      Int     @default(1)
  unitUzs       Int     @map("unit_uzs")
  totalUzs      Int     @map("total_uzs")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

/// Payment — provider tx. unique (provider, provider_transaction_id) (§6.5).
model Payment {
  id            String         @id @default(uuid()) @db.Uuid
  orderId       String         @map("order_id") @db.Uuid
  provider      PaymentProvider
  providerTxId  String?        @map("provider_tx_id")
  state         PaymentState   @default(INITIATED)
  amountUzs     Int            @map("amount_uzs")
  providerPayload Json?        @map("provider_payload") @db.JsonB
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz()

  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events PaymentEvent[]

  @@unique([provider, providerTxId])
  @@index([orderId])
  @@map("payments")
}

model PaymentEvent {
  id          String   @id @default(uuid()) @db.Uuid
  paymentId   String   @map("payment_id") @db.Uuid
  providerEventId String? @unique @map("provider_event_id")
  eventType   String   @map("event_type")
  payloadHash String?  @map("payload_hash")
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz()
  result      String?

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("payment_events")
}

/// Coupon — school-scoped, case-insensitive code.
model Coupon {
  id           String   @id @default(uuid()) @db.Uuid
  schoolId     String   @map("school_id") @db.Uuid
  code         String   @unique
  discountPercent Int?  @map("discount_percent")
  discountFixedUzs Int? @map("discount_fixed_uzs")
  maxRedemptions Int?   @map("max_redemptions")
  startsAt     DateTime? @map("starts_at") @db.Timestamptz()
  endsAt       DateTime? @map("ends_at") @db.Timestamptz()
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  redemptions CouponRedemption[]

  @@map("coupons")
}

model CouponRedemption {
  id        String   @id @default(uuid()) @db.Uuid
  couponId  String   @map("coupon_id") @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  discountUzs Int    @map("discount_uzs")
  redeemedBy String  @map("redeemed_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([couponId, orderId])
  @@map("coupon_redemptions")
}

// ── Student gamification (Faza 4, §4.3.1) ──────────────────────────────────

enum GamificationProfileState {
  ACTIVE
  FROZEN
  ARCHIVED
}

/// Student XP/badge/streak profili — faqat STUDENT membership (§4.3.1).
model StudentGamificationProfile {
  id               String                 @id @default(uuid()) @db.Uuid
  schoolId         String                 @map("school_id") @db.Uuid
  studentMemberId  String                 @map("student_member_id") @db.Uuid
  userId           String                 @map("user_id") @db.Uuid
  state            GamificationProfileState @default(ACTIVE)
  lifetimeXp       Int                    @default(0) @map("lifetime_xp")
  currentLevel     Int                    @default(1) @map("current_level")
  currentStreak    Int                    @default(0) @map("current_streak")
  bestStreak       Int                    @default(0) @map("best_streak")
  lastQualifyingDate DateTime?            @map("last_qualifying_date") @db.Timestamptz()
  leaderboardOptIn Boolean               @default(false) @map("leaderboard_opt_in")
  leaderboardAlias String?
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz()

  xpEvents      XpEvent[]
  streakDays    StreakDay[]
  studentBadges StudentBadge[]

  @@unique([schoolId, studentMemberId])
  @@index([userId])
  @@map("student_gamification_profiles")
}

/// Immutable XP ledger — signed/closed event_type, idempotency key (§4.3.1).
model XpEvent {
  id           String   @id @default(uuid()) @db.Uuid
  schoolId     String   @map("school_id") @db.Uuid
  profileId    String   @map("profile_id") @db.Uuid
  eventType    String   @map("event_type")
  amount       Int
  policyVersion Int     @map("policy_version")
  sourceEntity String?  @map("source_entity")
  sourceId     String?  @map("source_id")
  actorMemberId String? @map("actor_member_id")
  idempotencyKey String @unique @map("idempotency_key")
  occurredAt   DateTime @default(now()) @map("occurred_at") @db.Timestamptz()

  profile StudentGamificationProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, occurredAt])
  @@map("xp_events")
}

/// School-local streak day — unique (profile, local_date) (§4.3.1).
model StreakDay {
  id           String   @id @default(uuid()) @db.Uuid
  profileId    String   @map("profile_id") @db.Uuid
  localDate    DateTime @map("local_date") @db.Date
  policyVersion Int     @map("policy_version")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  profile StudentGamificationProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, localDate])
  @@map("streak_days")
}

/// Badge ta'rifi (immutable version) + student badge.
model Badge {
  id         String   @id @default(uuid()) @db.Uuid
  schoolId   String   @map("school_id") @db.Uuid
  key        String
  version    Int      @default(1)
  name       String
  iconKey    String?  @map("icon_key")
  criterionJson Json? @map("criterion_json") @db.JsonB
  isPublished Boolean @default(false) @map("is_published")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  studentBadges StudentBadge[]

  @@unique([schoolId, key, version])
  @@map("badges")
}

model StudentBadge {
  id        String   @id @default(uuid()) @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  badgeId   String   @map("badge_id") @db.Uuid
  awardedAt DateTime @default(now()) @map("awarded_at") @db.Timestamptz()
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz()
  sourceRef String?  @map("source_ref")

  profile StudentGamificationProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  badge   Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("student_badges")
}

// ── Homework (Faza 4, §6.4) ────────────────────────────────────────────────

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum ModuleType {
  MCG
  WRITING
  READING
  LISTENING
  SPEAKING
  GRAMMAR
  VOCABULARY
  GAP_FILL
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  RETURNED
  GRADED
}

enum ScoreSource {
  AUTO
  AI_SUGGESTION
  TEACHER
}

/// Assignment — lesson'ga bog'liq; max_points va rubric (§4.3, §6.4).
model Assignment {
  id          String           @id @default(uuid()) @db.Uuid
  schoolId    String           @map("school_id") @db.Uuid
  lessonId    String           @map("lesson_id") @db.Uuid
  title       String
  instructions String?
  dueAt       DateTime?        @map("due_at") @db.Timestamptz()
  maxPoints   Int              @default(100) @map("max_points")
  rubricJson  Json?            @map("rubric_json") @db.JsonB
  status      AssignmentStatus @default(DRAFT)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz()

  modules    AssignmentModule[]
  submissions Submission[]

  @@index([schoolId, lessonId])
  @@map("assignments")
}

/// Assignment moduli — type + config JSON (server runtime tekshiriladi, §6.4).
model AssignmentModule {
  id           String     @id @default(uuid()) @db.Uuid
  assignmentId String     @map("assignment_id") @db.Uuid
  type         ModuleType
  configJson   Json?      @map("config_json") @db.JsonB
  position     Int        @default(0)
  weight       Int        @default(1)

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, position])
  @@map("assignment_modules")
}

/// Submission — answers JSON; final_score faqat server side (§6.4).
model Submission {
  id               String           @id @default(uuid()) @db.Uuid
  schoolId         String           @map("school_id") @db.Uuid
  assignmentId     String           @map("assignment_id") @db.Uuid
  studentUserId    String           @map("student_user_id") @db.Uuid
  enrollmentId     String?          @map("enrollment_id") @db.Uuid
  status           SubmissionStatus @default(DRAFT)
  answersJson      Json?            @map("answers_json") @db.JsonB
  submittedAt      DateTime?        @map("submitted_at") @db.Timestamptz()
  finalScore       Int?             @map("final_score")
  finalGrader      String?          @map("final_grader")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz()

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  scores       SubmissionScore[]
  feedbackList Feedback[]

  @@unique([assignmentId, studentUserId])
  @@map("submissions")
}

/// Immutable score history — source va rubric version (§6.4).
model SubmissionScore {
  id            String     @id @default(uuid()) @db.Uuid
  submissionId  String     @map("submission_id") @db.Uuid
  moduleId      String?    @map("module_id") @db.Uuid
  source        ScoreSource
  score         Int
  maxScore      Int        @map("max_score")
  breakdownJson Json?      @map("breakdown_json") @db.JsonB
  rubricVersion Int        @default(1) @map("rubric_version")
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz()

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@map("submission_scores")
}

/// Feedback — teacher AI; rich sanitized body (§6.4).
model Feedback {
  id            String   @id @default(uuid()) @db.Uuid
  submissionId  String   @map("submission_id") @db.Uuid
  authorUserId  String?  @map("author_user_id") @db.Uuid
  authorIsAi    Boolean  @default(false) @map("author_is_ai")
  body          String
  visibility    String   @default("STUDENT")
  isFinalMarker Boolean  @default(false) @map("is_final_marker")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("feedback")
}

// ── Live classroom (Faza 5, §6.6, §7) ──────────────────────────────────────

enum RecordingState {
  OFF
  REQUESTED
  APPROVED
  RECORDING
  DECLINED
}

enum LiveSessionState {
  SCHEDULED
  PRE_JOIN
  LIVE
  ENDED
  CANCELED
}

enum LiveVisibility {
  ENROLLED_ONLY
  COHORT_ONLY
  PUBLIC_VIEW_ONLY
}

/// Live session — recording_state OFF default; egress faqat RECORDING'da (§7.2.1).
model LiveSession {
  id             String           @id @default(uuid()) @db.Uuid
  schoolId       String           @map("school_id") @db.Uuid
  lessonId       String?          @map("lesson_id") @db.Uuid
  title          String
  visibility     LiveVisibility   @default(ENROLLED_ONLY)
  roomName       String?          @unique @map("room_name")
  livekitRoomId  String?          @map("livekit_room_id")
  scheduledAt    DateTime         @map("scheduled_at") @db.Timestamptz()
  startedAt      DateTime?        @map("started_at") @db.Timestamptz()
  endedAt        DateTime?        @map("ended_at") @db.Timestamptz()
  state          LiveSessionState @default(SCHEDULED)
  hostMemberId   String?          @map("host_member_id")
  recordingState RecordingState   @default(OFF) @map("recording_state")
  recordingRequesterId String?     @map("recording_requester_id")
  recordingApproverId String?      @map("recording_approver_id")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz()

  participantEntries LiveParticipant[]
  recordings         Recording[]

  @@index([schoolId, scheduledAt])
  @@map("live_sessions")
}

/// Live participant — join/leave, quality aggregates; unique session/user.
model LiveParticipant {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @map("session_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  guestName String?  @map("guest_name")
  role      String   @default("STUDENT")
  joinedAt  DateTime? @map("joined_at") @db.Timestamptz()
  leftAt    DateTime? @map("left_at") @db.Timestamptz()
  durationSec Int?    @map("duration_sec")
  acknowledgedRecording Boolean @default(false) @map("acknowledged_recording")

  session LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@map("live_participants")
}

/// Recording — faqat RECORDING state'dan Egress orqali yaratiladi (§7.2.1).
model Recording {
  id          String   @id @default(uuid()) @db.Uuid
  sessionId   String   @map("session_id") @db.Uuid
  schoolId    String   @map("school_id") @db.Uuid
  egressId    String?  @unique @map("egress_id")
  state       String   @default("PENDING")
  durationSec Int?
  assetKey    String?  @map("asset_key")
  retentionDays Int?   @default(180) @map("retention_days")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  session LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@map("recordings")
}
