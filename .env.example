# Bilgim — lokal muhit namunasi.
# Haqiqiy .env fayli hech qachon commit qilinmaydi (§9: secrets repo/logda yo'q).

# Umumiy
NODE_ENV=development

# Data layer (lokal compose bilan mos)
DATABASE_URL=postgresql://bilgim:bilgim_local_dev@localhost:5432/bilgim
REDIS_URL=redis://localhost:6379

# Surface URLlar
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000

# Auth secretlari — production'da majburiy, min 32 belgi.
# Lokal uchun generatsiya: openssl rand -base64 48
AUTH_ACCESS_SECRET=dev-only-insecure-secret-change-me-0123456789abcdef
AUTH_REFRESH_SECRET=dev-only-insecure-secret-change-me-fedcba9876543210

# Cloudflare R2 / S3-mos object storage.
# Lokalda MinIO ishlatiladi: R2_ENDPOINT=http://localhost:9000
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=bilgim-minio
R2_SECRET_ACCESS_KEY=bilgim_minio_local_dev
R2_BUCKET=bilgim-local
R2_ENDPOINT=http://localhost:9000

# Observability — bo'sh bo'lsa instrumentation o'chirilgan
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Seed
SEED_TEST_PASSWORD=BilgimTest2026!
